<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Foto Barang -->
        <ImageView
            android:id="@+id/iv_foto"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_item"
            android:contentDescription="Foto barang" />

        <!-- Info Barang -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kursi Kayu Vintage"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/circlo_black"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_kategori"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Furniture"
                android:textSize="12sp"
                android:textColor="@color/circlo_green" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_location"
                    android:contentDescription="Lokasi" />

                <TextView
                    android:id="@+id/tv_lokasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Jakarta Selatan"
                    android:textSize="12sp"
                    android:textColor="@color/circlo_gray" />
            </LinearLayout>

            <!-- Tombol Ambil -->
            <Button
                android:id="@+id/btn_ambil"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:text="Ambil Barang"
                android:textSize="12sp"
                android:textColor="@color/circlo_white"
                android:background="@drawable/bg_button_green"
                android:paddingHorizontal="14dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Tombol Hapus dari Simpanan -->
        <ImageView
            android:id="@+id/iv_unsave"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top"
            android:src="@drawable/ic_favorite"
            android:contentDescription="Hapus dari simpanan"
            app:tint="@color/circlo_green" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
