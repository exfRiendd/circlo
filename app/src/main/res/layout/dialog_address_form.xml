<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Label (contoh: Rumah, Kantor)"
        android:textSize="12sp"
        android:textColor="@color/circlo_gray"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_label"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Rumah"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alamat lengkap"
        android:textSize="12sp"
        android:textColor="@color/circlo_gray"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_alamat"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="Jl. Contoh No. 1, RT 01/RW 02"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:textSize="14sp"
        android:gravity="top|start"
        android:inputType="textMultiLine" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kota / Kecamatan"
        android:textSize="12sp"
        android:textColor="@color/circlo_gray"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_kota"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Jakarta Selatan, DKI Jakarta"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Catatan / Patokan (opsional)"
        android:textSize="12sp"
        android:textColor="@color/circlo_gray"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_catatan"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Depan minimarket, dekat sekolah..."
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:inputType="text" />

</LinearLayout>