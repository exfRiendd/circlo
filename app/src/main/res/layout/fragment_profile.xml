<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/circlo_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Hijau -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/circlo_green"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/circlo_white" />

            <ImageView
                android:id="@+id/iv_settings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_settings"
                android:contentDescription="Pengaturan" />

            <!-- Info User -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_settings"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_person" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_nama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alit Sutalit Terbelit belit"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/circlo_white" />

                    <TextView
                        android:id="@+id/tv_lokasi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Jakarta, Indonesia"
                        android:textSize="12sp"
                        android:textColor="@color/circlo_white" />

                    <TextView
                        android:id="@+id/tv_joined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bergabung Januari 2025"
                        android:textSize="11sp"
                        android:textColor="@color/circlo_white" />
                </LinearLayout>
            </LinearLayout>

            <!-- Statistik -->
            <LinearLayout
                android:id="@+id/ll_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_user_info"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_diposting" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="12"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="@color/circlo_white" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Diposting" android:textSize="11sp" android:textColor="@color/circlo_white" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_diterima" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="8"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="@color/circlo_white" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Diterima" android:textSize="11sp" android:textColor="@color/circlo_white" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_dibagikan" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="15"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="@color/circlo_white" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Dibagikan" android:textSize="11sp" android:textColor="@color/circlo_white" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Dampak Lingkungan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_banner_green"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dampak Lingkungan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/circlo_white" />

            <TextView
                android:id="@+id/tv_dampak_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kamu telah membantu mengurangi sampah dengan berbagi 15 barang!"
                android:textSize="12sp"
                android:textColor="@color/circlo_white" />

            <ProgressBar
                android:id="@+id/progress_eco"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:progress="60"
                android:progressTint="@color/circlo_white"
                android:progressBackgroundTint="#80FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="5 barang lagi untuk mencapai level Eco Hero!"
                android:textSize="11sp"
                android:textColor="@color/circlo_white" />
        </LinearLayout>

        <!-- Menu Profil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Barang Saya -->
            <RelativeLayout
                android:id="@+id/menu_barang_saya"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_centerVertical="true" android:src="@drawable/ic_inventory"
                    android:contentDescription="Barang Saya" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_centerVertical="true" android:layout_marginStart="32dp"
                    android:text="Barang Saya" android:textSize="14sp" android:textColor="@color/circlo_black" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_right" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/circlo_border" />

            <!-- Barang Tersimpan -->
            <RelativeLayout
                android:id="@+id/menu_barang_tersimpan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_centerVertical="true" android:src="@drawable/ic_favorite"
                    android:contentDescription="Tersimpan" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_centerVertical="true" android:layout_marginStart="32dp"
                    android:text="Barang Tersimpan" android:textSize="14sp" android:textColor="@color/circlo_black" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_right" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/circlo_border" />

            <!-- Alamat Pengambilan -->
            <RelativeLayout
                android:id="@+id/menu_alamat"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_centerVertical="true" android:src="@drawable/ic_location"
                    android:contentDescription="Alamat" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_centerVertical="true" android:layout_marginStart="32dp"
                    android:text="Alamat Pengambilan" android:textSize="14sp" android:textColor="@color/circlo_black" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_right" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/circlo_border" />

            <!-- Notifikasi -->
            <RelativeLayout
                android:id="@+id/menu_notifikasi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_centerVertical="true" android:src="@drawable/ic_notifications"
                    android:contentDescription="Notifikasi" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_centerVertical="true" android:layout_marginStart="32dp"
                    android:text="Notifikasi" android:textSize="14sp" android:textColor="@color/circlo_black" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_right" />
            </RelativeLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
