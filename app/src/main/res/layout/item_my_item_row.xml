<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Foto Barang -->
        <ImageView
            android:id="@+id/iv_foto"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_item"
            android:contentDescription="Foto barang" />

        <!-- Info Barang -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kursi Kayu Vintage"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/circlo_black"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_kategori"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Furniture"
                android:textSize="12sp"
                android:textColor="@color/circlo_green" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Aktif"
                android:textSize="11sp"
                android:textColor="@color/circlo_white"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp" />

            <!-- Waktu Posting -->
            <TextView
                android:id="@+id/tv_waktu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Diposting 2 jam lalu"
                android:textSize="11sp"
                android:textColor="@color/circlo_gray" />
        </LinearLayout>

        <!-- Menu Opsi -->
        <ImageView
            android:id="@+id/iv_more"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="Opsi"
            android:padding="2dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
