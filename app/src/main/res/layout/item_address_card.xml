<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Baris atas: label + badge utama -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rumah"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/circlo_black" />

            <!-- Badge "Utama" — tampil jika alamat ini adalah default -->
            <TextView
                android:id="@+id/tv_badge_utama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Utama"
                android:textSize="11sp"
                android:textColor="@color/circlo_green"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Detail Alamat -->
        <TextView
            android:id="@+id/tv_alamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Jl. Sudirman No. 45, RT 03/RW 07"
            android:textSize="13sp"
            android:textColor="@color/circlo_black" />

        <TextView
            android:id="@+id/tv_kota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Kebayoran Baru, Jakarta Selatan, DKI Jakarta 12190"
            android:textSize="12sp"
            android:textColor="@color/circlo_gray" />

        <!-- Catatan / Patokan -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location"
                android:contentDescription="Catatan" />

            <TextView
                android:id="@+id/tv_catatan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Patokan: depan minimarket Indomaret"
                android:textSize="12sp"
                android:textColor="@color/circlo_gray"
                android:fontFamily="sans-serif-italic" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/circlo_border" />

        <!-- Tombol Aksi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_jadikan_utama"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jadikan Utama"
                android:textSize="13sp"
                android:textColor="@color/circlo_green"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/circlo_border" />

            <TextView
                android:id="@+id/btn_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit"
                android:textSize="13sp"
                android:textColor="@color/circlo_gray"
                android:gravity="center" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/circlo_border" />

            <TextView
                android:id="@+id/btn_hapus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hapus"
                android:textSize="13sp"
                android:textColor="@color/circlo_red"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
