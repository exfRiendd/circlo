<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/circlo_white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Circlo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/circlo_green" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location"
                    android:contentDescription="Lokasi" />

                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Jakarta, Indonesia"
                    android:textSize="12sp"
                    android:textColor="@color/circlo_gray" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_notif"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_notifications"
            android:contentDescription="Notifikasi" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_search_bar">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Cari" />

                <EditText
                    android:id="@+id/et_search"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="36dp"
                    android:hint="Cari barang yang kamu butuhkan..."
                    android:textSize="13sp"
                    android:textColorHint="@color/circlo_gray"
                    android:background="@null"
                    android:paddingEnd="12dp"
                    android:singleLine="true" />
            </RelativeLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/chip_semua"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Semua"
                        android:textSize="13sp"
                        android:textColor="@color/circlo_white"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:paddingHorizontal="16dp" />

                    <TextView
                        android:id="@+id/chip_furniture"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:text="Furniture"
                        android:textSize="13sp"
                        android:textColor="@color/circlo_black"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:paddingHorizontal="16dp" />

                    <TextView
                        android:id="@+id/chip_elektronik"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:text="Elektronik"
                        android:textSize="13sp"
                        android:textColor="@color/circlo_black"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:paddingHorizontal="16dp" />

                    <TextView
                        android:id="@+id/chip_pakaian"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:text="Pakaian"
                        android:textSize="13sp"
                        android:textColor="@color/circlo_black"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:paddingHorizontal="16dp" />

                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_banner_green"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bagikan, Ambil, Reuse!"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/circlo_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Bergabunglah dengan komunitas yang peduli lingkungan. Berikan barang bekasmu kehidupan baru."
                    android:textSize="12sp"
                    android:textColor="@color/circlo_white" />

                <Button
                    android:id="@+id/btn_mulai_posting"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:text="Mulai Posting"
                    android:textSize="13sp"
                    android:textColor="@color/circlo_green"
                    android:background="@color/circlo_white"
                    android:paddingHorizontal="16dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barang Tersedia"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/circlo_black" />

                <TextView
                    android:id="@+id/tv_jumlah_barang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="0 barang"
                    android:textSize="13sp"
                    android:textColor="@color/circlo_gray" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_barang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>